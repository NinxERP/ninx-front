{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ninx",
  "version": "1.0.2",
  "identifier": "com.ninx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ninx",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/maat-aug/ninx-front/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RjlCMTZEMUE5MDcwNzYKUldSMmNKQWFiYkg1ZE5nNjRvdUZjNDVXaDdCeFdodk1aa1VVbjJKQkp2MEd6QWo5Y3prWERYS2UK"
    }
  }
}
